{
  "name": "pandokary-assets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lint/format tooling for pandokary's browser assets (JS/CSS).",
  "repository": {
    "type": "git",
    "url": "https://github.com/dasun-sathsara/pandokary"
  },
  "author": "Dasun Sathsara",
  "license": "MIT",
  "scripts": {
    "test": "npm run check && npm run check:themes && npm run check:reader",
    "check:themes": "node tests/check-themes.mjs",
    "check:mermaid": "node tests/check-mermaid-browser.mjs",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:reader": "node tests/check-reader.mjs && node tests/check-reader-safety.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5"
  }
}
